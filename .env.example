APP_NAME="Judging System for Competition"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Timestamps are stored in UTC and displayed in APP_DISPLAY_TIMEZONE.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=judging_demo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Demo admin account created by `php artisan db:seed`.
# If APP_ADMIN_PASSWORD is empty the documented demo password from the README is used.
# Set your own value for anything other than a local demo.
APP_ADMIN_USERNAME=admin
APP_ADMIN_NAME="Demo Administrator"
APP_ADMIN_PASSWORD=
# Optional: override the shared demo judge password (default Judge@Demo2026)
# JUDGING_JUDGE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
